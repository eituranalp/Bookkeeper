{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "cppbuild",
			"label": "Build (Clang)",
			"command": "C:\\mingw64\\bin\\clang++.exe",
			"args": [
				"-g",
				"-std=c++20",
				"${workspaceFolder}\\*.cpp",
				"-o",
				"${workspaceFolder}\\main.exe"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [
				"$gcc"
			],
			"group": {
    			"kind": "build",
    			"isDefault": true
  			},
			"detail": "compiler: C:\\mingw64\\bin\\clang++.exe"
		},
		{
  			"label": "Run (main.exe)",
  			"type": "shell",
  			"command": "powershell",
			"args": [
    			"-NoProfile",
    			"-Command",
    			"& \"${workspaceFolder}\\main.exe\""
  			],
  			"dependsOn": "Build (Clang)",
  			"problemMatcher": [],
			"options": {
    			"cwd": "${workspaceFolder}"
  			}
		},

		//JAVA
		{
  			"label": "Java: build (Main.java)",
  			"type": "shell",
  			"command": "javac",
  			"args": ["Main.java"],
  			"options": { "cwd": "${workspaceFolder}" },
  			"problemMatcher": [],
  			"group": { "kind": "build", "isDefault": false }
		},
		{
  			"label": "Java: run (Main)",
  			"type": "shell",
  			"command": "java",
  			"args": ["Main"],
  			"options": { "cwd": "${workspaceFolder}" },
  			"dependsOn": "Java: build (Main.java)",
		  	"problemMatcher": []
		}


	]
}